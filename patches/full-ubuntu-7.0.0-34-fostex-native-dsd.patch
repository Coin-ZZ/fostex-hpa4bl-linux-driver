+/*
+ * Windows 2.2.1 transports four consecutive MSB-first DSD bytes per channel.
+ * Require an explicit opt-in and conservative descriptor shape. The exact
+ * hardware alternate layout remains to be verified before enabling this.
+ */
+static u64 fostex_dsd_format_quirk(struct snd_usb_audio *chip,
+				 struct audioformat *fp,
+				 unsigned int sample_bytes)
+{
+	struct usb_interface *iface = usb_ifnum_to_if(chip->dev, fp->iface);
+
+	if (iface && fp->protocol == UAC_VERSION_2 &&
+	    !(fp->endpoint & USB_DIR_IN) && fp->channels == 2 &&
+	    sample_bytes == 4 && fp->fmt_bits == 32 &&
+	    iface->num_altsetting >= 3 &&
+	    fp->altsetting == iface->num_altsetting - 1)
+		return SNDRV_PCM_FMTBIT_S32_LE | SNDRV_PCM_FMTBIT_DSD_U32_BE;
+	return 0;
+}
 
