+/*
+ * HP-A4BL advertises native-DSD transport rates in the shared clock range.
+ * Probe has not selected a mode, so rate_max (352800) is not a safe PCM
+ * initialization rate. Defer hardware setup to endpoint_prepare(), which
+ * selects the actual PCM/DSD mode before applying the requested clock.
+ */
+bool snd_usb_fostex_dsd_enabled(struct snd_usb_audio *chip)
+{
+	return is_fostex_dsd(chip);
+}
